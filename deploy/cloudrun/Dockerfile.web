# web 컨테이너: 화면(HTML·JS) + /api·/auth 를 api 서비스로 넘기는 nginx. 같은 도메인이라 로그인 쿠키가 그대로 동작.
FROM nginx:1.27-alpine
COPY server/static /usr/share/nginx/html/static
COPY server/static/index.html /usr/share/nginx/html/index.html
COPY deploy/cloudrun/nginx.conf.template /etc/nginx/templates/default.conf.template
# nginx 이미지가 시작할 때 템플릿의 ${PORT} ${API_URL} ${API_HOST} 를 환경변수로 채운다
ENV PORT=8080
