# 서버 환경변수 목록. 로컬은 프로젝트 루트 .env, Cloud Run 은 --set-env-vars / Secret Manager (docs/deploy_cloudrun.md). 값은 절대 커밋하지 않음
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
SESSION_SECRET=            # python3 -c "import secrets;print(secrets.token_hex(32))"
BASE_URL=https://도메인
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DAILY_CHAT_LIMIT=100
APP_ENV=prod
SUPABASE_DB_HOST=aws-0-<리전>.pooler.supabase.com   # Supabase → Connect → Direct → Session pooler
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<프로젝트ref>
SUPABASE_DB_PASSWORD=
